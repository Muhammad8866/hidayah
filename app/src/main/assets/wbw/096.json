{"t":["پڑھو اپنے رب کے نام سے جس نے پیدا کیا","آدمی کو خون کی پھٹک سے بنایا، پڑھو","اور تمہارا رب ہی سب سے بڑا کریم،","جس نے قلم سے لکھنا سکھایا","آدمی کو سکھایا جو نہ جانتا تھا","ہاں ہاں بیشک آدمی سرکشی کرتا ہے،","اس پر کہ اپنے آپ کو غنی سمجھ لیا","بیشک تمہارے رب ہی کی طرف پھرنا ہے","بھلا دیکھو تو جو منع کرتا ہے،","بندے کو جب وہ نماز پڑھے","بھلا دیکھو تو اگر وہ ہدایت پر ہوتا،","یا پرہیزگاری بتاتا تو کیا خوب تھا،","بھلا دیکھو تو اگر جھٹلایا اور منہ پھیرا","تو کیا حال ہوگا کیا نہ جانا کہ اللہ دیکھ رہا ہے","ہاں ہاں اگر باز نہ آیا تو ضرور ہم پیشانی کے بال پکڑ کر کھینچیں گے","کیسی پیشانی جھوٹی خطاکار،","اب پکارے اپنی مجلس کو","ابھی ہم سپاہیوں کو بلاتے ہیں","ہاں ہاں، اس کی نہ سنو اور سجدہ کرو اور ہم سے قریب ہوجاؤ، (السجدة ۔۱۴)"],"w":[[["اِقۡرَاۡ","iq'ra","Read","پڑھو","पढ़िए","(হে নবী) পড়","قرأ","قَرَأَ"],["بِاسۡمِ","bi-is'mi","in (the) name","ساتھ نام کے","नाम से","নামে","سمو","اسْم"],["رَبِّكَ","rabbika","(of) your Lord","اپنے رب کے","अपने रब के","তোমার রবের","ربب","رَبّ"],["الَّذِىۡ","alladhī","the One Who","وہ جس نے","वो जिसने","যিনি","","الَّذِي"],["خَلَقَۚ","khalaqa","created","پیدا کیا","पैदा किया","সৃষ্টি করেছেন","خلق","خَلَقَ"]],[["خَلَقَ","khalaqa","He created","پیدا کی","उसने पैदा किया","সৃষ্টি করেছেন","خلق","خَلَقَ"],["الۡاِنۡسَانَ","l-insāna","man","انسان کو","इन्सान को","মানুষকে","أنس","إِنسان"],["مِنۡ","min","from","سے","from","থেকে","","مِن"],["عَلَقٍۚ","ʿalaqin","a clinging substance","جمے ہوئے خون (سے)","जमे हुए ख़ून से","জমাট রক্তপিণ্ড","علق","عَلَق"]],[["اِقۡرَاۡ","iq'ra","Read","پڑھو","पढ़िए","পড়","قرأ","قَرَأَ"],["وَرَبُّكَ","warabbuka","and your Lord","اور رب تیرا","और रब आपका","আর তোমার রব","ربب","رَبّ"],["الۡاَكۡرَمُۙ","l-akramu","(is) the Most Generous","بڑا کریم ہے","सब से ज़्यादा करम वाला है","বড়ই অনুগ্রহশীল","كرم","أَكْرَم"]],[["الَّذِىۡ","alladhī","The One Who","وہ جس نے","वो जिसने","যিনি","","الَّذِي"],["عَلَّمَ","ʿallama","taught","سکھایا","सिखाया","শিখিয়েছেন","علم","عَلَّمَ"],["بِالۡقَلَمِۙ","bil-qalami","by the pen","ساتھ قلم کے","सा