{"t":["چاشت کی قسم","اور رات کی جب پردہ ڈالے","کہ تمہیں تمہارے رب نے نہ چھوڑا، اور نہ مکروہ جانا،","اور بیشک پچھلی تمہارے لیے پہلی سے بہتر ہے","اور بیشک قریب ہے کہ تمہارا رب تمہیں اتنا دے گا کہ تم راضی ہوجاؤ گے","کیا اس نے تمہیں یتیم نہ پایا پھر جگہ دی","اور تمہیں اپنی محبت میں خود رفتہ پایا تو اپنی طرف راہ دی","اور تمہیں حاجت مند پایا پھر غنی کردیا","تو یتیم پر دباؤ نہ ڈالو","اور منگتا کو نہ جھڑکو","اور اپنے رب کی نعمت کا خوب چرچا کرو"],"w":[[["وَالضُّحٰىۙ","wal-ḍuḥā","By the morning brightness","قسم ہے روز روشن کی","क़सम है चाश्त की","শপথ প্রথম প্রহরের","ضحو","ضُحًى"]],[["وَالَّيۡلِ","wa-al-layli","And the night","اور رات کی","और रात की","শপথ রাতের","ليل","لَيْل"],["اِذَا","idhā","when","جب","जब","যখন","","إِذا"],["سَجٰىۙ","sajā","it covers with darkness","وہ ڈھانپ لے","वो छा जाए","নিঝুম হয়","سجو","سَجَى"]],[["مَا","mā","Not","نہیں","नहीं","না","","ما"],["وَدَّعَكَ","waddaʿaka","has forsaken you","چھوڑا تجھ کو","छोड़ा आपको","তোমাকে ত্যাগ করেছেন","ودع","وَدَّعَ"],["رَبُّكَ","rabbuka","your Lord","تیرے رب نے","आपके रब ने","তোমার রব","ربب","رَبّ"],["وَمَا","wamā","and not","اور نہ","और ना","আর না","","و"],["قَلٰىؕ","qalā","He is displeased","وہ ناراض ہوا","वो नाराज़ हुआ","অসন্তুষ্ট হয়েছেন","قلي","قَلَى"]],[["وَلَـلۡاٰخِرَةُ","walalākhiratu","And surely the Hereafter","اور البتہ آخرت/ انجام","और यक़ीनन आख़िरत","এবং পরবর্তী (পরকাল) নিশ্চয়ই","أخر","آخِر"],["خَيۡرٌ","khayrun","(is) better","بہتر ہے","बेहतर है","উত্তম","خير","خَيْر"],["لَّكَ","laka","for you","تیرے لئے","आपके लिए","তোমার জন্য","","ل"],["مِنَ","mina","than","سے","than","অপেক্ষা (সময়)","","مِن"],["الۡاُوۡلٰىؕ","l-ūlā","the first","آغاز سے/ ابتداء سے","पहली (दुनिया) से","পূর্ববর্তী (ইহকাল)","أول","أَوَّل"]],[["وَلَسَوۡفَ","walasawfa","And soon","اور البتہ عنقریب","और यक़ीनन अनक़रीब","এবং শীঘ্রই অবশ্য","","و"],["يُعۡطِيۡكَ","yuʿ'ṭīka","will give you","عطا کرے گا تجھ کو","अता करेगा आपको","তোমাকে দান করবেন","عطو","أَعْطَى"],["رَبُّكَ","rabbuka","your Lord","تیرا رب","रब आपका","তোমার রব","ربب","رَبّ"],["فَتَر