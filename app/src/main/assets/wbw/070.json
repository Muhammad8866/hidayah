{"t":["ایک مانگنے والا وہ عذاب مانگتا ہے،","جو کافروں پر ہونے والا ہے، اس کا کوئی ٹالنے والا نہیں،","وہ ہوگا اللہ کی طرف سے جو بلندیوں کا مالک ہے","ملائکہ اور جبریل اس کی بارگاہ کی طرف عروج کرتے ہیں وہ عذاب اس دن ہوگا جس کی مقدار پچاس ہزار برس ہے","تو تم اچھی طرح صبر کرو،","وہ اسے دور سمجھ رہے ہیں","اور ہم اسے نزدیک دیکھ رہے ہیں","جس دن آسمان ہوگا جیسی گلی چاندی،","اور پہاڑ ایسے ہلکے ہوجائیں گے جیسے اون","اور کوئی دوست کسی دوست کی بات نہ پوچھے گا","ہوں گے انہیں دیکھتے ہوئے مجرم آرزو کرے گا، کاش! اس دن کے عذاب سے چھٹنے کے بدلے میں دے دے اپنے بیٹے،","اور اپنی جورو اور اپنا بھائی،","اور اپنا کنبہ جس میں اس کی جگہ ہے،","اور جتنے زمین میں ہیں سب پھر یہ بدلہ دنیا اسے بچالے،","ہرگز نہیں وہ تو بھڑکتی آگ ہے،","کھال اتار لینے والی بلارہی ہے","اس کو جس نے پیٹھ دی اور منہ پھیرا","اور جوڑ کر سینت رکھا (محفوظ کرلیا)","بیشک آدمی بنایا گیا ہے بڑا بے صبرا حریص،","جب اسے برائی پہنچے تو سخت گھبرانے والا،","اور جب بھلائی پہنچے تو روک رکھنے والا","مگر نمازی،","جو اپنی نماز کے پابند ہیں","اور وہ جن کے مال میں ایک معلوم حق ہے","اس کے لیے جو مانگے اور جو مانگ بھی نہ سکے تو محروم رہے","اور ہو جو انصاف کا دن سچ جانتے ہیں","اور وہ جو اپنے رب کے عذاب سے ڈر رہے ہیں،","بیشک ان کے رب کا عذاب نڈر ہونے کی چیز نہیں","اور ہو جو اپنی شرمگاہوں کی حفاظت کرتے ہیں،","مگر اپنی بیبیوں یا اپنے ہاتھ کے مال کنیزوں سے کہ ان پر کچھ ملامت نہیں،","تو جو ان دو کے سوا اور چاہے وہی حد سے بڑھنے والے ہیں","اور وہ جو اپنی امانتوں اور اپنے عہد کی حفاظت کرتے ہیں","اور وہ جو اپنی گواہیوں پر قائم ہیں","اور وہ جو اپنی نماز کی حفاظت کرتے ہیں","یہ ہیں جن کا باغوں میں اعزاز ہوگا","تو ان کافروں کو کیا ہوا تمہاری طرف تیز نگاہ سے دیکھتے ہیں","داہنے اور بائیں گروہ کے گروہ،","کیا ان میں ہر شخص یہ طمع کرتا ہے کہ چین کے باغ میں داخل کیا جائے،","ہرگز نہیں، بیشک ہم نے انہیں اس چیز سے بنایا جسے جانتے ہیں","تو مجھے قسم ہے اس کی جو سب پُوربوں سب پچھموں کا مالک ہے کہ ضرور ہم قادر ہیں،","کہ ان سے اچھے بدل دیں اور ہم سے کوئی نکل کر نہیں جاسکتا","تو انہیں چھوڑ دو ان کی بیہودگیوں میں پڑے اور کھیلتے ہوئے یہاں تک کہ اپنے اس دن سے ملیں جس کا انہیں وعدہ دیا جاتا ہے،","جس دن قبروں سے نکلیں گے جھپٹتے ہوئے گویا وہ نشانیوں کی طرف لپک رہے ہیں","آنکھیں نیچی کیے ہوئے ان پر ذلت سوار، یہ ہے ان کا وہ دن جس کا ان سے وعدہ تھا"],"w":[[["سَاَلَ","sa-ala","Asked","سوال کیا","सवाल किया","জিজ্ঞাসা করল","سأل","سَأَلَ"],["سَآٮِٕلٌ ۢ","sāilun","a questioner","سوال کرنے والے نے","सवाल करने वाले ने","এক প্রশ্নকারী","سأل","سائِل"],["بِعَذَابٍ","biʿadhābin","about a punishment","عذاب کا","उस अज़ाब का","এমন আযাব সম্পর্কে","عذب","عَذاب"],["وَّاقِعٍۙ","wāqiʿin","bound to happen","جو واقع ہونے والا ہے","जो वाक़ेअ होने वाला है","যা আপতিত হবে","وقع","واقِع"]],[["لِّلۡكٰفِرِيۡنَ","lil'kāfirīna","To the disbelievers","کافروں کے لیے","काफ़िरों के लिए","কাফিরদের উপর,","كفر","كافِر"],["لَيۡسَ","laysa","not","نہیں ہے","नहीं है","নেই","ليس","لَيْسَ"],["لَهٗ","lahu","of it","واسطے اس کے","उसे","তার","","ل"],["دَافِعٌ ۙ","dāfiʿun","any preventer","کوئی دفع کرنے والا","कोई दफ़ा करने वाला","কোন প্রতিরোধকারী","دفع","دافِع"]],[["مِّنَ","mina","From","کی طرف سے","From","থেকে","","مِن"],["اللّٰهِ","l-lahi","Allah","اللہ","अल्लाह की तरफ़ से","আল্লাহ,","أله","اللَّه"],["ذِى","dhī","Owner","جو مالک ہے","Owner","মালিক","","ذُو"],["الۡمَعَارِجِؕ","l-maʿāriji","(of) the ways of ascent","عروج کے زینوں کا","जो उरूज वाला है","ঊর্ধ্বারোহণের সোপানসমূহের অধিকারী","عرج","مَعارِج"]],[["تَعۡرُجُ","taʿruju","Ascend","چڑھتے ہیں","चढ़ते हैं","চড়ে","عرج","يَعْرُجُ"],["الۡمَلٰٓٮِٕكَةُ","l-malāikatu","the Angels","فرشتے","फ़रिश्ते","ফেরেশতাগণ","ملك","مَلَك"],["وَ الرُّوۡحُ","wal-rūḥu","and the Spirit","اور روح","और रूह","ও রূহ(জিবরাঈল)","روح","رُوح"],["اِلَيۡهِ","ilayhi","to Him","اس کی طرف","तरफ़ उसके","তাকে","","إِلَى"],["فِىۡ","fī","in","میں","in","মধ্যে","","فِي"],["يَوۡمٍ","yawmin","a Day","ایک دن","एक दिन में","একদিনের","يوم","يَوْم"],["كَانَ","kāna","[is]","ہے","है","[হয়]","كون","كانَ"],["مِقۡدَارُهٗ","miq'dāruhu","its measure","اسکی مقدار","मिक़दार जिसकी","তার পরিমাপ","قدر","مِقْدار"],["خَمۡسِيۡنَ","khamsīna","(is) fifty","پچاس","पचास","পঞ্চাশ (হয়)","خمس","خَمْسِ