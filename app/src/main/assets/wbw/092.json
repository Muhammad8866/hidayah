{"t":["اور رات کی قسم جب چھائے","اور دن کی جب چمکے","اور اس کی جس نے نر و مادہ بنائے","بیشک تمہاری کوشش مختلف ہے","تو وہ جس نے دیا اور پرہیزگاری کی","اور سب سے اچھی کو سچ مانا","تو بہت جلد ہم اسے آسانی مہیا کردیں گے","اور وہ جس نے بخل کیا اور بے پرواہ بنا","اور سب سے اچھی کو جھٹلایا","تو بہت جلد ہم اسے دشواری مہیا کردیں گے","اور اس کا مال اسے کام نہ آئے گا جب ہلاکت میں پڑے گا","بیشک ہدایت فرمانا ہمارے ذمہ ہے،","اور بیشک آخرت اور دنیا دونوں کے ہمیں مالک ہیں،","تو میں تمہیں ڈراتا ہوں اس آگ سے جو بھڑک رہی ہے،","نہ جائے گا اس میں مگر بڑا بدبخت،","جس نے جھٹلایا اور منہ پھیرا","اور بہت اس سے دور رکھا جائے گا جو سب سے زیادہ پرہیزگار،","جو اپنا مال دیتا ہے کہ ستھرا ہو","اور کسی کا اس پر کچھ احسان نہیں جس کا بدلہ دیا جائے","صرف اپنے رب کی رضا چاہتا ہے جو سب سے بلند ہے،","اور بیشک قریب ہے کہ وہ راضی ہوگا"],"w":[[["وَالَّيۡلِ","wa-al-layli","By the night","قسم ہے رات کی","क़सम है रात की","শপথ রাতের","ليل","لَيْل"],["اِذَا","idhā","when","جب","जब","যখন","","إِذا"],["يَغۡشٰىۙ","yaghshā","it covers","وہ چھا جائے","वो छा जाए","আচ্ছন্ন করে","غشو","غَشِيَ"]],[["وَالنَّهَارِ","wal-nahāri","And the day","قسم ہے دن کی","और दिन की","শপথ দিনের","نهر","نَهار"],["اِذَا","idhā","when","جب","जब","যখন","","إِذا"],["تَجَلّٰىۙ","tajallā","it shines in brightness","وہ روشن ہو","वो रौशन हो","আলোকিত হয়","جلو","تَجَلَّى"]],[["وَمَا","wamā","And He Who","اور اس کی جس نے","और उसकी","শপথ তাঁর (যিনি)","","و"],["خَلَقَ","khalaqa","created","پیدا کیا","जिसने पैदा किया","সৃষ্টি করেছেন","خلق","خَلَقَ"],["الذَّكَرَ","l-dhakara","the male","نر کو","नर","পুরুষ","ذكر","ذَكَر"],["وَالۡاُنۡثٰٓىۙ","wal-unthā","and the female","اور مادہ کو","और मादा को","ও নারী","أنث","أُنثَى"]],[["اِنَّ","inna","Indeed","بیشک","बेशक","নিশ্চয়ই","","إِنّ"],["سَعۡيَكُمۡ","saʿyakum","your efforts","تمہاری کوشش","कोशिश तुम्हारी","তোমাদের কর্মপ্রচেষ্টা","سعي","سَعْي"],["لَشَتّٰىؕ","lashattā","(are) surely diverse","البتہ مختلف طرح کی ہے","अलबत्ता मुख़्तलिफ़ तरह की है","অবশ্যই বিভিন্ন প্রকৃতির","شتت","شَتَّى"]],[["فَاَمَّا","fa-ammā",