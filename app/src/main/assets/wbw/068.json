{"t":["قلم اور ان کے لکھے کی قسم","تم اپنے رب کے فضل سے مجنون نہیں","اور ضرور تمہارے لیے بے انتہا ثواب ہے","اور بیشک تمہاری خُو بُو (خُلق) بڑی شان کی ہے","تو اب کوئی دم جاتا ہے کہ تم بھی دیکھ لو گے اور وہ بھی دیکھ لیں گے","کہ تم میں کون مجنون تھا،","بیشک تمہارا رب خوب جانتا ہے جو اس کی راہ سے بہکے، اور وہ خوب جانتا ہے جو راہ پر ہے،","تو جھٹلانے والوں کی بات نہ سننا،","وہ تو اس آرزو میں ہیں کہ کسی طرح تم نرمی کرو تو وہ بھی نرم پڑجائیں،","اور ہر ایسے کی بات نہ سننا جو بڑا قسمیں کھانے والا ذلیل","بہت طعنے دینے والا بہت اِدھر کی اُدھر لگاتا پھرنے والا","بھلائی سے بڑا روکنے والا حد سے بڑھنے والا گنہگار","درشت خُو اس سب پر طرہ یہ کہ اس کی اصل میں خطا","اس پر کہ کچھ مال اور بیٹے رکھتا ہے،","جب اس پر ہماری آیتیں پڑھی جائیں کہتا ہے کہ اگلوں کی کہانیاں ہیں","قریب ہے کہ ہم اس کی سور کی سی تھوتھنی پر داغ دیں گے","بیشک ہم نے انہیں جانچا جیسا اس باغ والوں کو جانچا تھا جب انہوں نے قسم کھائی کہ ضرور صبح ہوتے اس کھیت کو کاٹ لیں گے","اور انشاء اللہ نہ کہا","تو اس پر تیرے رب کی طرف سے ایک پھیری کرنے والا پھیرا کر گیا اور وہ سوتے تھے،","تو صبح رہ گیا جیسے پھل ٹوٹا ہوا","پھر انہوں نے صبح ہوتے ایک دوسرے کو پکارا،","کہ تڑکے اپنی کھیتی چلو اگر تمہیں کاٹنی ہے،","تو چلے اور آپس میں آہستہ آہستہ کہتے جاتے تھے کہ","ہرگز آج کوئی مسکین تمہارے باغ میں آنے نہ پائے،","اور تڑکے چلے اپنے اس ارادہ پر قدرت سمجھتے","پھر جب اسے بولے بیشک ہم راستہ بہک گئے","بلکہ ہم بے نصیب ہوئے","ان میں جو سب سے غنیمت تھا بولا کیا میں تم سے نہیں کہتا تھا کہ تسبیح کیوں نہیں کرتے","بولے پاکی ہے ہمارے رب کو بیشک ہم ظالم تھے،","اب ایک دوسرے کی طرف ملامت کرتا متوجہ ہوا","بولے ہائے خرابی ہماری بیشک ہم سرکش تھے","امید ہے ہمیں ہمارا رب اس سے بہتر بدل دے ہم اپنے رب کی طرف رغبت لاتے ہیں","مار ایسی ہوتی ہے اور بیشک آخرت کی مار سب سے بڑی، کیا اچھا تھا اگر وہ جانتے","بیشک ڈر والوں کے لیے ان کے رب کے پاس چین کے باغ ہیں","کیا ہم مسلمانوں کو مجرموں کا سا کردیں","تمہیں کیا ہوا کیسا حکم لگاتے ہو","کیا تمہارے لیے کوئی کتاب ہے اس میں پڑھتے ہو،","کہ تمہارے لیے اس میں جو تم پسند کرو،","یا تمہارے لیے ہم پر کچھ قسمیں ہیں قیامت تک پہنچتی ہوئی کہ تمہیں ملے گا جو کچھ دعویٰ کرتے ہو","تم ان سے پوچھو ان میں کون سا اس کا ضامن ہے","یا ان کے پاس کچھ شریک ہیں تو اپنے شریکوں کو لے کر آئیں اگر سچے ہیں","جس دن ایک ساق کھولی جائے گی (جس کے معنی اللہ ہی جانتا ہے) اور سجدہ کو بلائے جائیں گے تو نہ کرسکیں گے","نیچی نگاہیں کیے ہوئے ان پر خواری چڑھ رہی ہوگی، اور بیشک دنیا میں سجدہ کے لیے بلائے جاتے تھے جب تندرست تھے","تو جو اس بات کو جھٹلاتا ہے اسے مجھ پر چھوڑ دو قریب ہے کہ ہم انہیں آہستہ آہستہ لے جائیں گے جہاں سے انہیں خبر نہ ہوگی،","اور میں انہیں ڈھیل دوں گا، بیشک میری خفیہ تدبیر بہت پکی ہے","یا تم ان سے اجرت مانگتے ہو کہ وہ چٹی کے بوجھ میں دبے ہیں","یا ان کے پاس غیب ہے کہ وہ لکھ رہے ہیں","تو تم اپنے رب کے حکم کا انتظار کر و اور اس مچھلی والے کی طرح نہ ہونا جب اس حال میں پکارا کہ اس کا دل گھٹ رہا تھا","اگر اس کے رب کی نعمت اس کی خبر کو نہ پہنچ جاتی تو ضرور میدان پر پھینک دیا جاتا الزام دیا ہوا","تو اسے اس کے رب نے چن لیا اور اپنے قربِ خاص کے سزاواروں (حقداروں) میں کرلیا،","اور ضرور کافر تو ایسے معلوم ہوتے ہیں کہ گویا اپنی بد نظر لگا کر تمہیں گرادیں گے جب قرآن سنتے ہیں اور کہتے ہیں یہ ضرور عقل سے دور ہیں،","اور وہ تو نہیں مگر نصیحت سارے جہاں کے لیے"],"w":[[["نٓ","noon","Nun","ن","ن","নুন","",""],["وَالۡقَلَمِ","wal-qalami","By the pen","قسم ہے قلم کی","क़सम है क़लम की","কলমের শপথ","قلم","قَلَم"],["وَمَا","wamā","and what","اور قسم ہے اس کی جو کچھ","और उसकी जो","এবং যা","","و"],["يَسۡطُرُوۡنَۙ","yasṭurūna","they write","وہ لکھ رہے ہیں","वो लिखते हैं","তারা লিখছে","سطر","يَسْطُرُ"]],[["مَاۤ","mā","Not","نہیں ہیں","नहीं हैं","না","","ما"],["اَنۡتَ","anta","you (are)","آپ","आप","তুমি","",""],["بِـنِعۡمَةِ","biniʿ'mati","by (the) Grace","نعمت کے ساتھ","नेअमत से","অনুগ্রহে","نعم","نِعْمَة"],["رَبِّكَ","rabbika","(of) your Lord","اپنے رب کی","अपने रब की","তোমার রবের","ربب","رَبّ"],["بِمَجۡنُوۡنٍۚ","bimajnūnin","a madman","مجنون","कोई मजनून","পাগল","جنن","مَجْنُون"]],[["وَاِنَّ","wa-inna","And indeed","اور بیشک","और बेशक","এবং নিশ্চয়","","و"],["لَڪَ","laka","for you","آپ کے لیے","आपके लिए","তোমার জন্য","","ل"],["لَاَجۡرًا","la-ajran"