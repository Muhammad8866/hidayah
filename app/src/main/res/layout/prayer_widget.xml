<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/prayer_widget_background">
    <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="12sp" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textStyle="bold" android:textSize="20sp" />
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_accent" android:textStyle="bold" android:textSize="16sp" android:countDown="true" android:format="%s" />
    </LinearLayout>
    <TextView android:id="@+id/widget_next_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_fajr" style="@style/PrayerWidgetTime" />
        <TextView android:id="@+id/widget_dhuhr" style="@style/PrayerWidgetTime" />
        <TextView android:id="@+id/widget_asr" style="@style/PrayerWidgetTime" />
        <TextView android:id="@+id/widget_maghrib" style="@style/PrayerWidgetTime" />
        <TextView android:id="@+id/widget_isha" style="@style/PrayerWidgetTime" />
    </LinearLayout>
</LinearLayout>
